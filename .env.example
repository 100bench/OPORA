# Имена переменных закреплены для runtime-реализации MVP.
# Приложение пока не читает .env автоматически. Для локальной shell-сессии:
#   cp .env.example .env
#   set -a; . ./.env; set +a
# Не коммитьте заполненный .env и не передавайте эти значения Android-клиенту.

# Локально слушаем только loopback. Dockerfile переопределяет адрес внутри
# контейнера на 0.0.0.0:8080; внешний bind задаётся при docker run.
LISTEN_ADDR=127.0.0.1:8080

# Не обязателен для старта, health и детерминированных offline-команд. Без ключа
# /ready возвращает 503, а provider-backed функции недоступны. Fake-success нет.
OPENAI_API_KEY=

# Обязательная JSON-карта device ID -> случайный bearer token. Не храните здесь
# публичный пример, который можно случайно использовать как рабочий секрет.
# После загрузки .env сгенерируйте значение локально, как показано в README.
DEVICE_TOKENS_JSON=

# Закреплённые model IDs MVP. Runtime отклоняет другие env-значения: override
# требует изменения контракта, тестов, констант и нового ревью.
OPENAI_REASONING_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe-2025-12-15
